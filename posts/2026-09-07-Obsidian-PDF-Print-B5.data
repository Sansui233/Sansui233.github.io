[{"_1":2},"routes/posts.$slug",{"_3":4},"data",{"_5":6,"_7":-5,"_8":9},"post",{"_10":14,"_12":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"prevPost","nextPost",{"_10":11,"_12":13},"title","个人阅读 RSS 的最佳实践","slug","2026-06-02-personal-rss-reading-best-practice","用 Obsidian 导出笔记为一本书","2026-09-07-Obsidian-PDF-Print-B5","date","2026-09-07T12:57:58.000Z","description","排版还是太难了","draft",false,"metadata",{"_92":93,"_94":95},"excerpt","之前在 Memo 里说想把笔记印出来，以方便无法带手机时看。在 Obsidian 里自己有非常仔细调整过排版自己印了，之后还是送去网上的印刷店打印，可以效果差距非常大。专业的还是太专业了，特此记录。\n此次 PDF 成品可以 在此下载。\n一、Obsidian 导出配置\n插件\n\nBetter Export PDF：可预览，可加目录书签\nCode Block Customizer：伟大无需多言！代码块终于像样了，完全换掉了 Obsidian live mode 对于代码块的处理方式。\nAuto Heading：标题自动编","content_html","<p>之前在 Memo 里说想把笔记印出来，以方便无法带手机时看。在 Obsidian 里自己有非常仔细调整过排版自己印了，之后还是送去网上的印刷店打印，可以效果差距非常大。专业的还是太专业了，特此记录。</p>\n<p>此次 PDF 成品可以 <strong><a href=\"https://img-cf.sansui233.com/books/Excel%20%E6%95%B0%E6%8D%AE%E5%88%86%E6%9E%90%20Cookbook.pdf\">在此下载</a></strong>。</p>\n<h2>一、Obsidian 导出配置</h2>\n<h3>插件</h3>\n<ul>\n<li>Better Export PDF：可预览，可加目录书签</li>\n<li>Code Block Customizer：伟大无需多言！代码块终于像样了，完全换掉了 Obsidian live mode 对于代码块的处理方式。</li>\n<li>Auto Heading：标题自动编号。对于打印来说自动编号是很重要的。不过没有中文数字。</li>\n<li>一个文本编辑器，编辑打印用的 CSS 配置</li>\n</ul>\n<h3>CSS 配置</h3>\n<p>CSS 现在对于打印 (@media print) 的配置比我想得要多得多……</p>\n<ul>\n<li>自动页码，奇偶页码</li>\n<li>页眉页脚</li>\n<li>按大章节分页</li>\n<li>首页占一整页做封面</li>\n<li>防止标题被挤到页尾</li>\n<li>防止图片跨页</li>\n</ul>\n<p>表格的跨页表头还是自动续表的，CSS 还有计数器功能。我惊呆了好吧，原来这么强的吗？已经是符合本次基本的书籍导出的要求了。新的 CSS 还在加印刷相关的内容。</p>\n<p>Typst 更强也好用，但就一般笔记导出成书而言还是 markdown + css 快且广泛。\n<img src=\"https://img-cf.sansui233.com/imgs/2026/09/202609072304512.webp\" alt=\"\"></p>\n<p>上面具体配置我就不细说了，因为本人酷爱装修，样式都是长期累积的结果，印刷用的主题也是在原主题的基础上又叠了一层修修补补，直接放到 <a href=\"https://gist.github.com/Sansui233/aeb581779e7df8ba22a99f82584338fe#file-pdf-print-css\">gist 链接</a>上了。</p>\n<p><img src=\"https://img-cf.sansui233.com/imgs/2026/09/202609072227229.webp\" alt=\"\"></p>\n<h3>软件</h3>\n<p>一定要一个可以读取屏幕 dpi 查看实际大小的软件。Photoshop 是可以的， SummatraPDF 经过设置后也是可以的。其他的我没有试过。</p>\n<p>以 SummatraPDF 为例，在「设置」→「高级选项」中，设置 <code>CustomScreenDPI = 189</code> 。其中 189 是我的屏幕 DPI 。你可以直接查阅屏幕型号，或到 <a href=\"https://www.shutterstock.com/zh/image-design-tools/dpi-ppi-calculator?dd_referrer=https%3A%2F%2Fwww.google.com%2F\">这里</a> 计算。</p>\n<p>然后重启 SummatraPDF， <code>Ctrl+1</code> 就是打印大小了。</p>\n<h2>二、排版</h2>\n<p>对于主题，初期我尝试了使用网页风格无衬线主题 ，效果算是非常非常不行，主要打印出来的字非常大一个，而且粗细对比过强，网页感太重了。</p>\n<p>对于一般的纸张，书籍印刷确实非常不适合使用粗体字（Bold, weight 600)，除非你用铜版纸这类不吸墨的纸。500 的字重比较适合。</p>\n<p>适合印刷的主题是需要重新写的，才有了上面的效果。</p>\n<h3>纸张</h3>\n<p>可以说 <strong>纸张</strong> 和 <strong>纸张大小</strong> 在印刷里的重要程度能占 60%。</p>\n<ul>\n<li>纸张种类：道林纸（双胶纸），本白色。</li>\n<li>纸张大小：B5。</li>\n</ul>\n<p>首先是排除办公复印用的荧光剂 A4 纸。这个纸，即便你裁为 B5 的大小，认真胶装，加上铜版纸封面。但那种挺度、表面质感和刺眼的荧光白，仿佛小学复印店里复印出来的一样（实际上就是）。</p>\n<p>道林纸（双胶纸）是一种比较常见的纸张。值得注意的是，除非你住印厂旁边，街边的复印店是不会准备本白色的双胶纸的，连大学毕业论文打印的地方都是荧光白A4纸。我走完了一条街的广告店，有个女店主很认真介绍了她存放的纸的种类，说对于特种纸要提前给工厂定制，存放也是有要求的。</p>\n<p>如果不想寄印，只能自己买一打回去，带给打印店了。</p>\n<p>至于为什么 B5 大小……真的会觉得 A4 纸像书吗？</p>\n<h3>字号</h3>\n<h6>配置</h6>\n<ul>\n<li>网页： 16px</li>\n<li>Obsidian Better Export 导出缩放：80%</li>\n<li>实际大小：9.6pt</li>\n</ul>\n<p>Chromium 的 PDF 导出以 96dpi 导出，于是 16px 的字体对应的是 12pt。之前买过 Rei 的《印刷排雷手册》，12pt 在正文印刷里已经算是老年人字号了。</p>\n<p>因为我想制作册子，使用的是 B5 大小印刷。在初期，我只是问了 AI 缩放到 85% 是否可行（字体大小10.2pt），AI 说可以，我印出来也觉得凑合。但当我拿到专业印厂的印刷后，才发现 10.2 pt 和 9.6 pt 虽然看起来差不太多，但舒适度差距比想象得大…… 10 pt 还是更适合 A4 尺寸。</p>\n<h3>边距</h3>\n<h6>配置</h6>\n<ul>\n<li>css:</li>\n</ul>\n<pre><code class=\"language-css\">@media print {\n    @page {\n        margin: 12mm 10mm 14mm; /* 正文 80% 缩放不知自带 6mm 边距*/\n    }\n}\n</code></pre>\n<ul>\n<li>实际边距：左 16mm，上 18mm，右 16mm，下 20mm</li>\n</ul>\n<p>我没有搞懂为什么 margin 为 0 还是有自带了边距，有可能是我的原来的傻逼主题干的（并不）。</p>\n<p>实际边距是 GPT 的推荐值，也是我从印厂拿到的胶印书籍里的测量值。</p>\n<h3>行间距与段间距</h3>\n<p>这部分反而是祖宗之法。</p>\n<ul>\n<li>行间距: 1.5倍。</li>\n<li>段间距: 1倍 margin。</li>\n</ul>\n<p>1.5 倍行间距也是考虑到我的笔记有大量的 bullet，没有超过 3 行的长段落，大概比较像教材。小说类的行间距是更稀疏的。</p>\n<h2>装订</h2>\n<p>我对册子要求就是能平摊，能平摊，能平摊。我讨厌不工整的纸，谢谢。</p>\n<p>最开始我使用了固体胶装，牢固是牢固的，但是好像，因为真的干不了所以到处黏纸……后面还是使用了经典的白乳胶放一晚上，非常牢固且照顾手残。</p>\n<p>而印厂因为能打印 B3 的尺寸，小册直接用骑马钉了。</p>\n<h2>印厂的调整</h2>\n<p><img src=\"https://img-cf.sansui233.com/imgs/2026/09/202609072237670.webp\" alt=\"\"></p>\n<p>我发给印厂的 PDF 存在着诸多问题。不标准的字体大小，下边距过窄。但是印厂把各个边距给我裁得相当之标准。骑马钉所在的内侧边距要微大于右侧边距。</p>\n<p>我的上边距是标准的，所以印厂没有变上边距，只是整体缩小给了下边距和左右边距正确的选择，，可以说是非常细致地排版过了。</p>\n<p>最难的灰度网点，AM 胶印的细腻的网点，家用的激光打印机打不出来……真的打不出来。</p>\n<p>整个印刷质量、均匀程度和办公用的激光打印机相比，实在差得太多了。</p>","content_jsx","const{Fragment:n,jsx:i,jsxs:e}=arguments[0];function _createMdxContent(l){const r={a:\"a\",code:\"code\",h2:\"h2\",h3:\"h3\",h6:\"h6\",img:\"img\",li:\"li\",p:\"p\",pre:\"pre\",span:\"span\",strong:\"strong\",ul:\"ul\",...l.components};return e(n,{children:[i(r.p,{children:\"之前在 Memo 里说想把笔记印出来，以方便无法带手机时看。在 Obsidian 里自己有非常仔细调整过排版自己印了，之后还是送去网上的印刷店打印，可以效果差距非常大。专业的还是太专业了，特此记录。\"}),\"\\n\",e(r.p,{children:[\"此次 PDF 成品可以 \",i(r.strong,{children:i(r.a,{href:\"https://img-cf.sansui233.com/books/Excel%20%E6%95%B0%E6%8D%AE%E5%88%86%E6%9E%90%20Cookbook.pdf\",children:\"在此下载\"})}),\"。\"]}),\"\\n\",i(r.h2,{id:\"一obsidian-导出配置\",children:\"一、Obsidian 导出配置\"}),\"\\n\",i(r.h3,{id:\"插件\",children:\"插件\"}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"Better Export PDF：可预览，可加目录书签\"}),\"\\n\",i(r.li,{children:\"Code Block Customizer：伟大无需多言！代码块终于像样了，完全换掉了 Obsidian live mode 对于代码块的处理方式。\"}),\"\\n\",i(r.li,{children:\"Auto Heading：标题自动编号。对于打印来说自动编号是很重要的。不过没有中文数字。\"}),\"\\n\",i(r.li,{children:\"一个文本编辑器，编辑打印用的 CSS 配置\"}),\"\\n\"]}),\"\\n\",i(r.h3,{id:\"css-配置\",children:\"CSS 配置\"}),\"\\n\",i(r.p,{children:\"CSS 现在对于打印 (@media print) 的配置比我想得要多得多……\"}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"自动页码，奇偶页码\"}),\"\\n\",i(r.li,{children:\"页眉页脚\"}),\"\\n\",i(r.li,{children:\"按大章节分页\"}),\"\\n\",i(r.li,{children:\"首页占一整页做封面\"}),\"\\n\",i(r.li,{children:\"防止标题被挤到页尾\"}),\"\\n\",i(r.li,{children:\"防止图片跨页\"}),\"\\n\"]}),\"\\n\",i(r.p,{children:\"表格的跨页表头还是自动续表的，CSS 还有计数器功能。我惊呆了好吧，原来这么强的吗？已经是符合本次基本的书籍导出的要求了。新的 CSS 还在加印刷相关的内容。\"}),\"\\n\",e(r.p,{children:[\"Typst 更强也好用，但就一般笔记导出成书而言还是 markdown + css 快且广泛。\\n\",i(r.img,{src:\"https://img-cf.sansui233.com/imgs/2026/09/202609072304512.webp\",alt:\"\"})]}),\"\\n\",e(r.p,{children:[\"上面具体配置我就不细说了，因为本人酷爱装修，样式都是长期累积的结果，印刷用的主题也是在原主题的基础上又叠了一层修修补补，直接放到 \",i(r.a,{href:\"https://gist.github.com/Sansui233/aeb581779e7df8ba22a99f82584338fe#file-pdf-print-css\",children:\"gist 链接\"}),\"上了。\"]}),\"\\n\",i(r.img,{src:\"https://img-cf.sansui233.com/imgs/2026/09/202609072227229.webp\",alt:\"\"}),\"\\n\",i(r.h3,{id:\"软件\",children:\"软件\"}),\"\\n\",i(r.p,{children:\"一定要一个可以读取屏幕 dpi 查看实际大小的软件。Photoshop 是可以的， SummatraPDF 经过设置后也是可以的。其他的我没有试过。\"}),\"\\n\",e(r.p,{children:[\"以 SummatraPDF 为例，在「设置」→「高级选项」中，设置 \",i(r.code,{children:\"CustomScreenDPI = 189\"}),\" 。其中 189 是我的屏幕 DPI 。你可以直接查阅屏幕型号，或到 \",i(r.a,{href:\"https://www.shutterstock.com/zh/image-design-tools/dpi-ppi-calculator?dd_referrer=https%3A%2F%2Fwww.google.com%2F\",children:\"这里\"}),\" 计算。\"]}),\"\\n\",e(r.p,{children:[\"然后重启 SummatraPDF， \",i(r.code,{children:\"Ctrl+1\"}),\" 就是打印大小了。\"]}),\"\\n\",i(r.h2,{id:\"二排版\",children:\"二、排版\"}),\"\\n\",i(r.p,{children:\"对于主题，初期我尝试了使用网页风格无衬线主题 ，效果算是非常非常不行，主要打印出来的字非常大一个，而且粗细对比过强，网页感太重了。\"}),\"\\n\",i(r.p,{children:\"对于一般的纸张，书籍印刷确实非常不适合使用粗体字（Bold, weight 600)，除非你用铜版纸这类不吸墨的纸。500 的字重比较适合。\"}),\"\\n\",i(r.p,{children:\"适合印刷的主题是需要重新写的，才有了上面的效果。\"}),\"\\n\",i(r.h3,{id:\"纸张\",children:\"纸张\"}),\"\\n\",e(r.p,{children:[\"可以说 \",i(r.strong,{children:\"纸张\"}),\" 和 \",i(r.strong,{children:\"纸张大小\"}),\" 在印刷里的重要程度能占 60%。\"]}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"纸张种类：道林纸（双胶纸），本白色。\"}),\"\\n\",i(r.li,{children:\"纸张大小：B5。\"}),\"\\n\"]}),\"\\n\",i(r.p,{children:\"首先是排除办公复印用的荧光剂 A4 纸。这个纸，即便你裁为 B5 的大小，认真胶装，加上铜版纸封面。但那种挺度、表面质感和刺眼的荧光白，仿佛小学复印店里复印出来的一样（实际上就是）。\"}),\"\\n\",i(r.p,{children:\"道林纸（双胶纸）是一种比较常见的纸张。值得注意的是，除非你住印厂旁边，街边的复印店是不会准备本白色的双胶纸的，连大学毕业论文打印的地方都是荧光白A4纸。我走完了一条街的广告店，有个女店主很认真介绍了她存放的纸的种类，说对于特种纸要提前给工厂定制，存放也是有要求的。\"}),\"\\n\",i(r.p,{children:\"如果不想寄印，只能自己买一打回去，带给打印店了。\"}),\"\\n\",i(r.p,{children:\"至于为什么 B5 大小……真的会觉得 A4 纸像书吗？\"}),\"\\n\",i(r.h3,{id:\"字号\",children:\"字号\"}),\"\\n\",i(r.h6,{id:\"配置\",children:\"配置\"}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"网页： 16px\"}),\"\\n\",i(r.li,{children:\"Obsidian Better Export 导出缩放：80%\"}),\"\\n\",i(r.li,{children:\"实际大小：9.6pt\"}),\"\\n\"]}),\"\\n\",i(r.p,{children:\"Chromium 的 PDF 导出以 96dpi 导出，于是 16px 的字体对应的是 12pt。之前买过 Rei 的《印刷排雷手册》，12pt 在正文印刷里已经算是老年人字号了。\"}),\"\\n\",i(r.p,{children:\"因为我想制作册子，使用的是 B5 大小印刷。在初期，我只是问了 AI 缩放到 85% 是否可行（字体大小10.2pt），AI 说可以，我印出来也觉得凑合。但当我拿到专业印厂的印刷后，才发现 10.2 pt 和 9.6 pt 虽然看起来差不太多，但舒适度差距比想象得大…… 10 pt 还是更适合 A4 尺寸。\"}),\"\\n\",i(r.h3,{id:\"边距\",children:\"边距\"}),\"\\n\",i(r.h6,{id:\"配置-1\",children:\"配置\"}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"css:\"}),\"\\n\"]}),\"\\n\",i(r.pre,{children:e(r.code,{className:\"hljs language-css\",children:[i(r.span,{className:\"hljs-keyword\",children:\"@media\"}),\" print {\\n    \",i(r.span,{className:\"hljs-keyword\",children:\"@page\"}),\" {\\n        \",i(r.span,{className:\"hljs-attribute\",children:\"margin\"}),\": \",i(r.span,{className:\"hljs-number\",children:\"12mm\"}),\" \",i(r.span,{className:\"hljs-number\",children:\"10mm\"}),\" \",i(r.span,{className:\"hljs-number\",children:\"14mm\"}),\"; \",i(r.span,{className:\"hljs-comment\",children:\"/* 正文 80% 缩放不知自带 6mm 边距*/\"}),\"\\n    }\\n}\\n\"]})}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"实际边距：左 16mm，上 18mm，右 16mm，下 20mm\"}),\"\\n\"]}),\"\\n\",i(r.p,{children:\"我没有搞懂为什么 margin 为 0 还是有自带了边距，有可能是我的原来的傻逼主题干的（并不）。\"}),\"\\n\",i(r.p,{children:\"实际边距是 GPT 的推荐值，也是我从印厂拿到的胶印书籍里的测量值。\"}),\"\\n\",i(r.h3,{id:\"行间距与段间距\",children:\"行间距与段间距\"}),\"\\n\",i(r.p,{children:\"这部分反而是祖宗之法。\"}),\"\\n\",e(r.ul,{children:[\"\\n\",i(r.li,{children:\"行间距: 1.5倍。\"}),\"\\n\",i(r.li,{children:\"段间距: 1倍 margin。\"}),\"\\n\"]}),\"\\n\",i(r.p,{children:\"1.5 倍行间距也是考虑到我的笔记有大量的 bullet，没有超过 3 行的长段落，大概比较像教材。小说类的行间距是更稀疏的。\"}),\"\\n\",i(r.h2,{id:\"装订\",children:\"装订\"}),\"\\n\",i(r.p,{children:\"我对册子要求就是能平摊，能平摊，能平摊。我讨厌不工整的纸，谢谢。\"}),\"\\n\",i(r.p,{children:\"最开始我使用了固体胶装，牢固是牢固的，但是好像，因为真的干不了所以到处黏纸……后面还是使用了经典的白乳胶放一晚上，非常牢固且照顾手残。\"}),\"\\n\",i(r.p,{children:\"而印厂因为能打印 B3 的尺寸，小册直接用骑马钉了。\"}),\"\\n\",i(r.h2,{id:\"印厂的调整\",children:\"印厂的调整\"}),\"\\n\",i(r.img,{src:\"https://img-cf.sansui233.com/imgs/2026/09/202609072237670.webp\",alt:\"\"}),\"\\n\",i(r.p,{children:\"我发给印厂的 PDF 存在着诸多问题。不标准的字体大小，下边距过窄。但是印厂把各个边距给我裁得相当之标准。骑马钉所在的内侧边距要微大于右侧边距。\"}),\"\\n\",i(r.p,{children:\"我的上边距是标准的，所以印厂没有变上边距，只是整体缩小给了下边距和左右边距正确的选择，，可以说是非常细致地排版过了。\"}),\"\\n\",i(r.p,{children:\"最难的灰度网点，AM 胶印的细腻的网点，家用的激光打印机打不出来……真的打不出来。\"}),\"\\n\",i(r.p,{children:\"整个印刷质量、均匀程度和办公用的激光打印机相比，实在差得太多了。\"})]})}return{default:function(n={}){const{wrapper:e}=n.components||{};return e?i(e,{...n,children:i(_createMdxContent,{...n})}):_createMdxContent(n)}};","toc",[46,47,48,49],"tags",[45],"categories","工具","keywords",[40,41,42,43,44],"permalink","/posts/2026-09-07-Obsidian-PDF-Print-B5","PDF","Obsidian","print","css","印刷","教程",{"_10":77,"_51":78,"_53":79},{"_10":58,"_51":59,"_53":60},{"_10":55,"_51":56,"_53":57},{"_10":50,"_51":52,"_53":54},"印厂的调整","url","#印厂的调整","items",[],"装订","#装订",[],"二、排版","#二排版",[61,62,63,64],{"_10":74,"_51":75,"_53":76},{"_10":71,"_51":72,"_53":73},{"_10":68,"_51":69,"_53":70},{"_10":65,"_51":66,"_53":67},"行间距与段间距","#行间距与段间距",[],"边距","#边距",[],"字号","#字号",[],"纸张","#纸张",[],"一、Obsidian 导出配置","#一obsidian-导出配置",[80,81,82],{"_10":89,"_51":90,"_53":91},{"_10":86,"_51":87,"_53":88},{"_10":83,"_51":84,"_53":85},"软件","#软件",[],"CSS 配置","#css-配置",[],"插件","#插件",[],"readingTime",3,"wordCount",902.96]
